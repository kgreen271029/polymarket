# ═══════════════════════════════════════════════════
# ALPACA — Stocks + Crypto
# Get keys at: https://alpaca.markets → Dashboard
# ═══════════════════════════════════════════════════
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# ═══════════════════════════════════════════════════
# ROBINHOOD AGENTIC TRADING
# Run get_robinhood_token.py LOCALLY on your machine to get these.
# The script handles OAuth, PKCE, and prints the values to paste here.
# ═══════════════════════════════════════════════════
ROBINHOOD_MCP_TOKEN=your_access_token_from_get_robinhood_token_script
ROBINHOOD_REFRESH_TOKEN=your_refresh_token_from_get_robinhood_token_script
ROBINHOOD_CLIENT_ID=your_client_id_from_get_robinhood_token_script

# ═══════════════════════════════════════════════════
# POLYMARKET — Prediction Markets
# Create EVM wallet, get private key (hex with 0x prefix)
# Deposit USDC on Polygon network
# ═══════════════════════════════════════════════════
POLYMARKET_PRIVATE_KEY=0xyour_evm_private_key_here
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase_here

# ═══════════════════════════════════════════════════
# AI ANALYSIS
# Get at: https://console.anthropic.com
# ═══════════════════════════════════════════════════
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ═══════════════════════════════════════════════════
# NEWS DATA
# Free tier at: https://newsapi.org (100 req/day)
# ═══════════════════════════════════════════════════
NEWS_API_KEY=your_newsapi_key_here

# ═══════════════════════════════════════════════════
# RISK MANAGEMENT
# ═══════════════════════════════════════════════════
STARTING_CAPITAL=100.0
MAX_RISK_PER_TRADE=20.0
DAILY_LOSS_LIMIT_PCT=0.15
MAX_OPEN_POSITIONS=6

# ═══════════════════════════════════════════════════
# SYSTEM
# ═══════════════════════════════════════════════════
LOG_LEVEL=INFO
