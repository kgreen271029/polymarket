# FREE Trading Bot Setup Guide
# ====================

# REQUIRED - Get FREE Groq API Key (1 min setup):
# 1. Go to: https://console.groq.com/keys (from your phone browser)
# 2. Sign up with email
# 3. Copy your API key
# 4. Paste it here:
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL - Robinhood (for real trading, can add later):
# Get from Robinhood app if you want live trading
ROBINHOOD_MCP_TOKEN=your_token_here
ROBINHOOD_REFRESH_TOKEN=your_refresh_token_here
ROBINHOOD_CLIENT_ID=your_client_id_here

# OPTIONAL - Telegram notifications (for alerts on trades):
# Set these if you want trade alerts on your phone via Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# News API (optional, for better analysis):
# NEWS_API_KEY=your_news_api_key_here

# Trading Parameters (can adjust):
STARTING_CAPITAL=92.65
MAX_RISK_PER_TRADE=20.0
DAILY_LOSS_LIMIT_PCT=0.15
MAX_OPEN_POSITIONS=6
LOG_LEVEL=INFO
